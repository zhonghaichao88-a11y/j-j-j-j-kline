# 复制为 .env（Windows 双击 start.bat 会自动生成）
# 默认仅本机可访问；如需手机局域网访问，先配置访问控制，再设置 0.0.0.0。
APP_HOST=127.0.0.1
# Docker 使用此变量控制宿主机网卡监听范围
APP_BIND_ADDRESS=127.0.0.1
APP_USERNAME=admin
APP_PORT=8000
# 局域网开放时必须设置口令，随后手机通过同一 Wi-Fi 的电脑IP访问
APP_PASSWORD=
# 自动采集间隔秒数；0 表示关闭，建议 3600 以上，谨慎遵守各平台限额
SYNC_INTERVAL_SECONDS=0
# 持续监控的社交平台采集默认弹出可见浏览器窗口（0）。设为 1 改为无头后台模式，
# 但小红书/抖音/知乎/微博等基本都会弹出登录或验证页，无头模式无法处理，不建议。
MONITOR_HEADLESS=0
# 遇到登录/验证页时，等待你在浏览器窗口手动完成的秒数
MONITOR_LOGIN_WAIT_SECONDS=60
# 采集浏览器的代理：auto（默认）= 检测到系统代理时，抖音/小红书/微博/知乎/B站/快手/贴吧直连，TikTok 等境外网站走代理；
# direct = 完全不用代理；system = 全部跟随系统代理；也可以直接填代理地址，例如 http://127.0.0.1:7890
BROWSER_PROXY=auto
SEED_DEMO=0
DATABASE_URL=sqlite:///./data/lead_radar.db
# ---------------- 4.0 新增来源（不填也能用的已经默认开启）
# Reddit 已基本禁止未登录访问：到 https://www.reddit.com/prefs/apps 免费创建 script 应用，填下面两项
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Stack Exchange：默认搜 stackoverflow,softwarerecs,webapps；填 KEY 后每天额度 300 -> 10000
STACKEXCHANGE_SITES=stackoverflow,softwarerecs,webapps
STACKEXCHANGE_KEY=
# Lemmy / Mastodon 实例；Mastodon 不填令牌时按 #话题 读取，填了令牌可全文搜索
LEMMY_INSTANCE=lemmy.world
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=
# 要监控的 Discourse 论坛域名，逗号隔开，例如 forum.example.com,community.example.org
DISCOURSE_SITES=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
GITHUB_API_TOKEN=
# 高意向新线索推送：企业微信/钉钉/飞书群机器人、Server酱、Slack、Discord 的 Webhook 地址（自动识别格式）
# 钉钉机器人请在安全设置里添加自定义关键词：Lead Radar
ALERT_WEBHOOK_URL=
# 下列平台必须由你自己的官方/授权数据源提供 JSON API 地址，空白不能采集
DOUYIN_API_URL=
DOUYIN_API_TOKEN=
XHS_API_URL=
XHS_API_TOKEN=
KUAISHOU_API_URL=
KUAISHOU_API_TOKEN=
WEIBO_API_URL=
WEIBO_API_TOKEN=
ZHIHU_API_URL=
ZHIHU_API_TOKEN=
BILIBILI_API_URL=
BILIBILI_API_TOKEN=
TIKTOK_API_URL=
TIKTOK_API_TOKEN=
INSTAGRAM_API_URL=
INSTAGRAM_API_TOKEN=
FACEBOOK_API_URL=
FACEBOOK_API_TOKEN=
LINKEDIN_API_URL=
LINKEDIN_API_TOKEN=
TELEGRAM_API_URL=
TELEGRAM_API_TOKEN=
THREADS_API_URL=
THREADS_API_TOKEN=
PINTEREST_API_URL=
PINTEREST_API_TOKEN=
QUORA_API_URL=
QUORA_API_TOKEN=
MASTODON_API_URL=
MASTODON_API_TOKEN=
BLUESKY_API_URL=
BLUESKY_API_TOKEN=
PRODUCTHUNT_API_URL=
PRODUCTHUNT_API_TOKEN=
